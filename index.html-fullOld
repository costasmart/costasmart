        </section>

        <!-- Banner CTA WhatsApp -->
        <section class="py-20 bg-gradient-to-b from-brand-dark to-neutral-900 text-center border-t border-neutral-800">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="w-16 h-16 rounded-2xl bg-brand-red/10 border border-brand-red/30 flex items-center justify-center text-brand-red text-3xl mx-auto mb-6">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <h3 class="text-3xl sm:text-4xl font-black text-white mb-4">Pronto para Proteger seu Veículo ou Frota?</h3>
                <p class="text-neutral-400 mb-8 text-lg">Fale agora mesmo com um de nossos atendentes especialistas pelo WhatsApp e garanta condições especiais.</p>
                <a href="https://wa.me/5579999999999?text=Olá,%20gostaria%20de%20falar%20com%20o%20atendimento%20da%20Costa%20Smart%20Rastreadores" target="_blank" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-8 py-4 rounded-2xl inline-flex items-center space-x-3 shadow-2xl transition-all text-lg">
                    <i class="fa-brands fa-whatsapp text-2xl"></i>
                    <span>Chamar no WhatsApp Comercial</span>
                </a>
            </div>
        </section>

    </main>

    <footer class="bg-brand-dark border-t border-neutral-800 py-12 text-center text-neutral-500 text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-lg bg-brand-red flex items-center justify-center text-white font-bold text-sm">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <span class="font-bold text-white">COSTA SMART RASTREADORES</span>
            </div>
            <p>&copy; 2026 Costa Smart Rastreadores. Todos os direitos reservados. Pronto para GitHub Pages.</p>
            <div class="flex space-x-4">
                <a href="https://wa.me/5579999999999?text=Olá,%20vim%20pelo%20site" target="_blank" class="w-10 h-10 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-emerald-600 transition-all">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>
            </div>
        </div>
    </footer>

    <!-- JavaScript para o carrossel automático do Hero -->
    <script>
        const carouselSlides = [
            {
                bg: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?q=80&w=1920&auto=format&fit=crop",
                badge: "Atendimento Empresas & Pessoa Física",
                title: "Rastreamento Inteligente para <span class='text-brand-red'>Sua Frota</span> e Seu Carro.",
                desc: "Segurança satelital 24 horas. Atendemos desde frotas corporativas completas até veículos particulares com monitoramento pelo celular e bloqueio remoto imediato."
            },
            {
                bg: "https://images.unsplash.com/photo-1519003722824-194d4455a60c?q=80&w=1920&auto=format&fit=crop",
                badge: "Solução Comercial para Frotas",
                title: "Gestão Completa de <span class='text-brand-red'>Frotas Corporativas</span>.",
                desc: "Monitore rotas em tempo real, reduza custos operacionais de combustível e tenha total controle sobre seus caminhões e utilitários."
            },
            {
                bg: "https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=1920&auto=format&fit=crop",
                badge: "Solução para Carros Particulares",
                title: "Proteção Absoluta para o seu <span class='text-brand-red'>Carro Particular</span>.",
                desc: "Tranquilidade total para você e sua família. Aplicativo simples e intuitivo no celular com alerta de ignição e recuperação veicular."
            }
        ];

        let currentSlide = 0;
        const bgElement = document.getElementById('m1-carousel-bg');
        const badgeElement = document.getElementById('m1-badge');
        const titleElement = document.getElementById('m1-title');
        const descElement = document.getElementById('m1-desc');

        function setCarouselSlide(index) {
            currentSlide = index;
            const slide = carouselSlides[currentSlide];
            
            if(bgElement) {
                bgElement.style.backgroundImage = `url('${slide.bg}')`;
                badgeElement.innerText = slide.badge;
                titleElement.innerHTML = slide.title;
                descElement.innerText = slide.desc;

                // Atualizar indicadores visuais
                for(let i = 0; i < carouselSlides.length; i++) {
                    const dot = document.getElementById(`m1-dot-${i}`);
                    if(dot) {
                        if(i === currentSlide) {
                            dot.className = "w-8 h-2 rounded-full bg-brand-red transition-all";
                        } else {
                            dot.className = "w-3 h-2 rounded-full bg-neutral-600 transition-all";
                        }
                    }
                }
            }
        }

        // Passar automaticamente o carrossel a cada 5 segundos
        setInterval(() => {
            currentSlide = (currentSlide + 1) % carouselSlides.length;
            setCarouselSlide(currentSlide);
        }, 5000);
    </script>
</body>
</html>