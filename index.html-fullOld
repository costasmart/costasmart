                <a href="#faq" class="hover:text-brand-red transition-colors">Dúvidas</a>
            </nav>

            <!-- Ação Rápida WhatsApp -->
            <div>
                <a href="https://wa.me/5579999999999?text=Olá,%20gostaria%20de%20fazer%20um%20orçamento%20para%20rastreamento%20veicular" target="_blank" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition-all shadow-lg shadow-emerald-600/30 flex items-center space-x-2">
                    <i class="fa-brands fa-whatsapp text-lg"></i>
                    <span class="hidden sm:inline">WhatsApp Comercial</span>
                    <span class="inline sm:hidden">WhatsApp</span>
