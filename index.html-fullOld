                        <a href="https://wa.me/5579999999999?text=Olá,%20gostaria%20de%20proteger%20meu%20carro%20particular%20com%20rastreador" target="_blank" class="w-full bg-brand-red hover:bg-brand-darkRed text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-lg shadow-brand-red/30 flex items-center justify-center space-x-2">
